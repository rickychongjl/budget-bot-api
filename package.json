{
  "name": "budge-bot-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Budge Bot — one Cloudflare Worker holding the whole product. M1: platform, data & configuration foundation.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run test/integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "openai": "^7.10.0",
    "postgres": "^3.4.9",
    "zod": "^4.5.4"
  }
}
